
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY tools/PersonalFinanceTracker.Migrations/ tools/PersonalFinanceTracker.Migrations/
COPY Database/Migrations/ Database/Migrations/

RUN dotnet publish tools/PersonalFinanceTracker.Migrations/PersonalFinanceTracker.Migrations.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/runtime:10.0
RUN apt-get update && apt-get install -y --no-install-recommends libgssapi-krb5-2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "PersonalFinanceTracker.Migrations.dll"]
